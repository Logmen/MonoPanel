// Живое демо панели на demo.monopanel.app (устройство — в README.md рядом).
// Сборка — Workers Builds: root directory demo, npm run build, npx wrangler deploy.
{
  // Должно совпадать с именем проекта в дашборде Cloudflare.
  "name": "monopanel-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "demo.monopanel.app", "custom_domain": true }],
  // Страница с кнопкой; всё остальное решает воркер (сессия → контейнер).
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "containers": [
    {
      "class_name": "DemoPanel",
      // Образ собирается из корня репозитория: нужны web/, cmd/, internal/, templates/.
      "image": "./Dockerfile",
      "image_build_context": "..",
      // 1/16 vCPU и 256 МБ: панели с подготовленным демо этого хватает.
      "instance_type": "lite",
      // Потолок одновременных демо: дальше посетитель видит «попробуйте позже».
      "max_instances": 25
    }
  ],
  "durable_objects": { "bindings": [{ "name": "DEMO", "class_name": "DemoPanel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoPanel"] }],
  // Не больше пяти новых демо в минуту с одного адреса.
  "ratelimits": [{ "name": "STARTS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
