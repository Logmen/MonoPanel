# Generated by MonoPanel — webmail on its own port. Do not edit: changes will be overwritten.
# The name and certificate are the mail server's, so no separate DNS record is
# needed: https://example.com:2096/
server {
    listen 127.0.0.1:2096 ssl;
    http2 on;
    server_name example.com;
    ssl_certificate     /var/lib/monopanel/certs/example.com/fullchain.pem;
    ssl_certificate_key /var/lib/monopanel/certs/example.com/privkey.pem;
    include monopanel/snippets/ssl.conf;

    root  /var/www/alex/data/www/example.com;
    index index.php;
    access_log /var/log/monopanel/sites/alex/webmail.access.log main;
    error_log  /var/log/monopanel/sites/alex/webmail.error.log;
    client_max_body_size 64m;
    disable_symlinks if_not_owner from=$document_root;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include monopanel/snippets/deny-dotfiles.conf;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # Roundcube 1.7 serves its CSS and JS through /static.php/<path>: the
    # script takes the path after its name (PATH_INFO).
    location ~ ^/[^/]+\.php(?:/|$) {
        if (!-f $document_root$fastcgi_script_name) { return 404; }
        fastcgi_pass unix:/run/monopanel/php/example.com.sock;
        include monopanel/snippets/fastcgi.conf;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/monopanel/php/example.com.sock;
        include monopanel/snippets/fastcgi.conf;
    }
}
