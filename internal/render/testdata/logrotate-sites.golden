# Generated by MonoPanel — do not edit: the panel rewrites this file whenever an
# account comes or goes.
#
# Site logs live in the accounts' homes, where the accounts may write. Each
# account's logs rotate under that account (su), so nothing it puts there makes
# logrotate act as root. A log rotates weekly, or on the daily run once it has
# passed 100 MB; eight rotations stay, compressed from the second one on.
#
# Every log is the account's, mode 0660: the panel creates them so before nginx,
# Apache or php-fpm opens them, and create below keeps it so. logrotate before
# 3.19 (EL9) opens a log to rotate it and read-write to compress it; nginx
# changes only the owner when it reopens, php-fpm keeps a slow log it finds.
#
# Afterwards nginx gets USR1 (its workers reopen the logs, which is why the web
# group may pass through data/logs) and Apache a graceful restart, both through
# their pid files: asking systemd from here is what SELinux denies logrotate.
# PHP opens its error log and php-fpm its slow log anew for every write, so they
# need no signal.

/var/www/alex/data/logs/*.access.log /var/www/alex/data/logs/*.error.log /var/www/alex/data/logs/*.php.slow.log {
	su alex alex
	weekly
	maxsize 100M
	rotate 8
	nodateext
	missingok
	notifempty
	compress
	delaycompress
	create 0660 alex alex
	sharedscripts
	postrotate
		[ ! -s /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
		[ ! -s /run/apache2/apache2.pid ] || kill -USR1 "$(cat /run/apache2/apache2.pid)" 2>/dev/null || true
	endscript
}

/var/www/shop/data/logs/*.access.log /var/www/shop/data/logs/*.error.log /var/www/shop/data/logs/*.php.slow.log {
	su shop shop
	weekly
	maxsize 100M
	rotate 8
	nodateext
	missingok
	notifempty
	compress
	delaycompress
	create 0660 shop shop
	sharedscripts
	postrotate
		[ ! -s /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
		[ ! -s /run/apache2/apache2.pid ] || kill -USR1 "$(cat /run/apache2/apache2.pid)" 2>/dev/null || true
	endscript
}
