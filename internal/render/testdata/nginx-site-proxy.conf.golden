# Generated by MonoPanel for example.com — do not edit. Custom directives: monopanel/sites/example.com.d/*.conf
server {
    listen 203.0.113.10:80;
    server_name example.com www.example.com;
    include monopanel/snippets/acme.conf;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 203.0.113.10:443 ssl;
    http2 on;
    listen 203.0.113.10:443 quic;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    server_name example.com www.example.com;
    ssl_certificate     /var/lib/monopanel/certs/example.com/fullchain.pem;
    ssl_certificate_key /var/lib/monopanel/certs/example.com/privkey.pem;
    include monopanel/snippets/ssl.conf;
    include monopanel/snippets/acme.conf;

    if ($host = www.example.com) { return 301 $scheme://example.com$request_uri; }
    root  /var/www/alex/data/www/example.com;
    index index.php index.html index.htm;
    access_log /var/www/alex/data/logs/example.com.access.log main;
    error_log  /var/www/alex/data/logs/example.com.error.log;
    client_max_body_size 64m;
    disable_symlinks if_not_owner from=$document_root;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include monopanel/snippets/deny-dotfiles.conf;
    include monopanel/sites/example.com.d/*.conf;

    location / {
        include monopanel/snippets/proxy-app.conf;
        proxy_pass http://127.0.0.1:3000;
    }
}
