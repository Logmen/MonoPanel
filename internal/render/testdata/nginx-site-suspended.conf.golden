# Generated by MonoPanel for example.com — site is suspended.
server {
    listen 203.0.113.10:80;
    listen 203.0.113.10:443 ssl;
    http2 on;
    ssl_certificate     /var/lib/monopanel/certs/example.com/fullchain.pem;
    ssl_certificate_key /var/lib/monopanel/certs/example.com/privkey.pem;
    include monopanel/snippets/ssl.conf;
    server_name example.com www.example.com;
    include monopanel/snippets/acme.conf;
    location / {
        default_type text/html;
        return 503 '<!doctype html><html lang="ru"><meta charset="utf-8"><title>example.com</title><body style="font-family:system-ui;margin:10% auto;max-width:36em;text-align:center"><h1>Сайт временно недоступен</h1><p>example.com приостановлен администратором хостинга.</p></body></html>';
    }
}
