# Generated by MonoPanel for alex (cache) — do not edit; use `mp valkey`.
[Unit]
Description=MonoPanel valkey cache of alex
After=network.target

[Service]
# Started means ready: the snapshot is loaded and the socket accepts, so a
# restart does not hand PHP a missing socket and lose its sessions.
Type=notify
User=alex
Group=alex
# Only the account reaches the server: a unix socket with mode 600 in a
# directory of its own, no TCP port. The whole configuration is here, on the
# command line: the account cannot read the panel's /etc/monopanel.
ExecStart=/usr/bin/valkey-server --supervised systemd --daemonize no --port 0 \
	--unixsocket /run/monopanel-valkey/alex-cache/valkey.sock --unixsocketperm 600 \
	--dir /var/lib/monopanel-valkey/alex-cache --maxmemory 128mb \
	--maxmemory-policy allkeys-lru --save ""
RuntimeDirectory=monopanel-valkey/alex-cache
RuntimeDirectoryMode=0700
StateDirectory=monopanel-valkey/alex-cache
StateDirectoryMode=0700
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
MemoryMax=320M
# Mount sandboxing only. ProtectKernelTunables=, ProtectKernelModules= and
# RestrictAddressFamilies= imply NoNewPrivileges= for a non-root User=, and
# under it EL9's policy keeps the server in init_t instead of redis_t — where
# it may not write its own snapshots.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
