# Generated by MonoPanel for example.com — do not edit. Custom directives: /etc/apache2/monopanel/accounts/alex/sites/example.com.d/*.conf
<VirtualHost 127.100.3.233:81>
    ServerName example.com
    ServerAlias www.example.com
    # A virtual host inherits the rewrite rule of httpd.conf's that refuses
    # what nginx did not send only with mod_rewrite switched on at its own
    # level; httpd.conf switches it off again for the directories.
    RewriteEngine On
    DocumentRoot /var/www/alex/data/www/example.com
    <Directory /var/www/alex/data/www/example.com>
        AllowOverride All
        Options -Indexes +SymLinksIfOwnerMatch
        Require all granted
    </Directory>
    # Shared folder: another account writes here. No .htaccess in it is read
    # (one would hand any name to PHP or switch the owner check of symlinks
    # off), no PHP from it runs, also for a request that comes past nginx, and
    # a symlink in it leads only to a file of the link's owner.
    <Directory /var/www/alex/data/www/example.com/upload/exchange>
        AllowOverride None
        Options +SymLinksIfOwnerMatch
        <FilesMatch "\.(?:php|phtml|phar)$">
            Require all denied
        </FilesMatch>
    </Directory>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/monopanel/php/example.com.sock|fcgi://localhost"
    </FilesMatch>
    ProxyTimeout 150
    ErrorLog  /var/log/monopanel/sites/alex/example.com.apache.error.log
    CustomLog /var/log/monopanel/sites/alex/example.com.apache.access.log combined
    IncludeOptional /etc/apache2/monopanel/accounts/alex/sites/example.com.d/*.conf
</VirtualHost>
