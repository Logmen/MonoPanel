# Generated by MonoPanel — default server for 203.0.113.10: ACME challenges, HTTP/3 reuseport, unknown hosts.
# Port 443 refuses the handshake of a name no site has, and of a client without
# SNI: without this block nginx would answer them with the first site of the
# address in file order, and show its certificate. A site chosen for the
# clients without SNI (mp site set --default-tls) answers those instead.
server {
    listen 203.0.113.10:80 default_server;
    server_name _;
    include monopanel/snippets/acme.conf;
    location / {
        return 444;
    }
}

server {
    listen 203.0.113.10:443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     /c.pem;
    ssl_certificate_key /k.pem;
    include monopanel/snippets/ssl.conf;
    # A client without SNI — a reverse proxy that connects by IP — gets the
    # certificate of kz.example.com (mp site set --default-tls), and its Host
    # picks the site; one that names the address itself is sent to
    # kz.example.com, another name no site has is refused below.
    location / {
        return 301 https://kz.example.com$request_uri;
    }
}

# A name no site has, when it comes as SNI, is still refused: any name with a
# letter, which an address never has (a Host that is the address itself, from
# a client without SNI, lands in the block above).
server {
    listen 203.0.113.10:443 ssl;
    http2 on;
    server_name "~[a-z]";
    include monopanel/snippets/ssl.conf;
    ssl_reject_handshake on;
    return 444;
}
