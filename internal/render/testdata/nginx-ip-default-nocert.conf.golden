# Generated by MonoPanel — default server for [2001:db8::10]: ACME challenges, HTTP/3 reuseport, unknown hosts.
# Port 443 refuses the handshake of a name no site has, and of a client without
# SNI: without this block nginx would answer them with the first site of the
# address in file order, and show its certificate.
server {
    listen [2001:db8::10]:80 default_server;
    server_name _;
    include monopanel/snippets/acme.conf;
    location / {
        # The panel's own name without the port leads to the panel; a site
        # with that name would match before this block and win.
        if ($host = "panel.example.com") { return 301 https://$host:8443$request_uri; }
        return 444;
    }
}

server {
    listen [2001:db8::10]:443 ssl default_server;
    http2 on;
    server_name _;
    include monopanel/snippets/ssl.conf;
    ssl_reject_handshake on;
}
