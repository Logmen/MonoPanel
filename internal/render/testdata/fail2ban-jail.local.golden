# Generated by MonoPanel — jails for SSH, nginx and the panel itself.
[DEFAULT]
banaction = nftables-multiport
banaction_allports = nftables-allports
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
mode = aggressive

[monopanel]
enabled = true
port = 8443
filter = monopanel
journalmatch = _SYSTEMD_UNIT=monopanel-api.service
maxretry = 5

[nginx-http-auth]
enabled = true
backend = auto
logpath = /var/log/nginx/error.log

[nginx-botsearch]
enabled = true
backend = auto
logpath = /var/log/nginx/access.log
