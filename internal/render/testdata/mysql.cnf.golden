# Generated by MonoPanel — sized for 4096 MB RAM. Custom settings: add another file in this directory.
[mysqld]
bind-address = 127.0.0.1
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
innodb_buffer_pool_size = 1024M
innodb_redo_log_capacity = 256M
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2
max_connections = 200
table_open_cache = 4000
tmp_table_size = 64M
max_heap_table_size = 64M
local_infile = OFF
# Strict mode refuses tables whose row size exceeds the InnoDB limit and
# imports from older servers; CMS installers and dumps hit both, so it is off.
innodb_strict_mode = OFF
# READ-COMMITTED and a lenient sql_mode are what 1C-Bitrix requires and what
# WordPress, Joomla and OpenCart run on anyway.
transaction_isolation = READ-COMMITTED
sql_mode = NO_ENGINE_SUBSTITUTION
max_allowed_packet = 64M
thread_cache_size = 32
sort_buffer_size = 2M
join_buffer_size = 2M
read_rnd_buffer_size = 1M
performance_schema = ON
disable_log_bin
slow_query_log = ON
slow_query_log_file = /var/log/mysql/monopanel-slow.log
long_query_time = 2
# legacy PHP (< 7.4, mysqlnd without caching_sha2_password) is installed
mysql_native_password = ON
