# Generated by MonoPanel — sized for 4096 MB RAM. The file is rewritten:
# change the server's settings in the panel (Databases → server settings, or
# mp db config set key=value).
[mysqld]
bind-address = 127.0.0.1
innodb_buffer_pool_size = 1024M
# Strict mode refuses oversized rows.
innodb_strict_mode = OFF
disable_log_bin
# set in the panel; the panel's value: NO_ENGINE_SUBSTITUTION
sql_mode = ''
# legacy PHP (< 7.4, mysqlnd without caching_sha2_password) is installed.
# The plugin alone is not enough: the server still offers caching_sha2_password
# in the handshake, and mysqlnd of PHP 5.6/7.0 drops the connection before the
# auth switch even for a mysql_native_password account.
mysql_native_password = ON
authentication_policy = mysql_native_password,,
