# Generated by MonoPanel — default server for 203.0.113.10: ACME challenges, HTTP/3 reuseport, unknown hosts.
server {
    listen 203.0.113.10:80 default_server;
    server_name _;
    include monopanel/snippets/acme.conf;
    location / {
        # The panel's own name without the port leads to the panel; a site
        # with that name would match before this block and win.
        if ($host = "panel.example.com") { return 301 https://$host:8443$request_uri; }
        return 444;
    }
}

server {
    listen 203.0.113.10:443 ssl default_server;
    http2 on;
    listen 203.0.113.10:443 quic reuseport;
    server_name _;
    ssl_certificate     /c.pem;
    ssl_certificate_key /k.pem;
    include monopanel/snippets/ssl.conf;
    ssl_reject_handshake on;
}
