# Generated by MonoPanel — Apache runs behind nginx on loopback only.
Listen 127.0.0.1:8080
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5

RemoteIPHeader X-Real-IP
RemoteIPInternalProxy 127.0.0.1

<Directory /var/www>
    Options -Indexes +SymLinksIfOwnerMatch
    AllowOverride All
    Require all granted
</Directory>

IncludeOptional /etc/apache2/monopanel/sites/*.conf
