# Generated by MonoPanel — Apache runs behind nginx on loopback only.
Listen 127.0.0.1:8080
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5

RemoteIPHeader X-Real-IP
RemoteIPInternalProxy 127.0.0.1

<Directory /var/www>
    Options -Indexes +SymLinksIfOwnerMatch
    # .htaccess may set any directive but the options that run programs as
    # the web server's account (ExecCGI, the exec of Includes): that account
    # reads every site's files.
    AllowOverride All Options=Indexes,MultiViews,FollowSymLinks,SymLinksIfOwnerMatch,IncludesNOEXEC
    Require all granted
</Directory>

IncludeOptional /etc/apache2/monopanel/sites/*.conf
