; Generated by MonoPanel for {{ .Name }} — do not edit. Per-site PHP settings are managed in the panel.
[{{ .Name }}]
user  = {{ .User }}
group = {{ .Group }}
listen = {{ .Socket }}
listen.owner = {{ .User }}
listen.group = {{ .ListenGroup }}
listen.mode  = 0660
pm = {{ .PM }}
pm.max_children = {{ .MaxChildren }}
{{- if eq .PM "dynamic" }}
pm.start_servers = {{ .StartServers }}
pm.min_spare_servers = {{ .MinSpare }}
pm.max_spare_servers = {{ .MaxSpare }}
{{- end }}
pm.process_idle_timeout = 10s
pm.max_requests = 500
request_terminate_timeout = {{ .TerminateTimeout }}s
slowlog = {{ .LogDir }}/{{ .Name }}.php.slow.log
request_slowlog_timeout = 10s
catch_workers_output = yes
clear_env = no
env[PATH]   = {{ .BinDir }}:/usr/local/bin:/usr/bin:/bin
env[HOME]   = {{ .Home }}
env[TMPDIR] = {{ .TmpDir }}
{{- if .OpenBasedir }}
php_admin_value[open_basedir]      = {{ .DataDir }}
{{- end }}
php_admin_value[upload_tmp_dir]    = {{ .TmpDir }}
php_admin_value[session.save_path] = {{ .TmpDir }}/sess
php_admin_value[sys_temp_dir]      = {{ .TmpDir }}
php_admin_value[error_log]         = {{ .LogDir }}/{{ .Name }}.php.error.log
php_admin_flag[log_errors]         = on
php_admin_value[sendmail_path]     = /usr/sbin/sendmail -t -i -f {{ .SendmailFrom }}
php_admin_value[disable_functions] = {{ .DisableFunctions }}
{{- range .Values }}
php_value[{{ .Key }}] = {{ .Value }}
{{- end }}
