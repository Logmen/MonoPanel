{{- /* 1C-Bitrix on nginx + php-fpm (BitrixVM rules): urlrewrite fallback, core/cache dirs closed, no PHP in upload */ -}}
{{- define "preset-bitrix" }}

    # --- preset: 1C-Bitrix ---
    location = /favicon.ico { log_not_found off; access_log off; }
    location = /robots.txt  { allow all; log_not_found off; access_log off; }
    location ~* ^/bitrix/(?:modules|local_cache|stack_cache|managed_cache|php_interface)/ { deny all; return 404; }
    location ~* ^/local/(?:modules|php_interface)/ { deny all; return 404; }
    location ~* ^/upload/1c_[^/]+/ { deny all; return 404; }
    location ~* ^/(?:upload|bitrix/images|bitrix/tmp)/.*\.(?:php|phtml|phar|pl|py|sh|cgi)$ { deny all; return 403; }
    location ~* ^/bitrix/(?:cache|html_pages)/.*\.(?:php|phtml|phar)$ { deny all; return 403; }

    location ~* \.(?:css|js|mjs|map|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot|otf|mp4|webm|mp3|pdf|zip|gz)$ {
        try_files $uri =404;
        include monopanel/snippets/static-cache.conf;
{{- template "tlsheaders" . }}
    }
    location / { try_files $uri $uri/ /bitrix/urlrewrite.php$is_args$args; }
    location ~ \.php$ {
        try_files $uri =404;
        include monopanel/snippets/fastcgi.conf;
        fastcgi_pass unix:{{ .FPMSocket }};
    }
{{- end }}
