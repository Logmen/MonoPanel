# Generated by MonoPanel — default server for {{ .IP }}: ACME challenges, HTTP/3 reuseport, unknown hosts.
server {
    listen {{ .IP }}:80 default_server;
    server_name _;
    include monopanel/snippets/acme.conf;
    location / {
{{- if .PanelHost }}
        # The panel's own name without the port leads to the panel; a site
        # with that name would match before this block and win.
        if ($host = "{{ .PanelHost }}") { return 301 https://$host:{{ .PanelPort }}$request_uri; }
{{- end }}
        return 444;
    }
}
{{- if .TLS }}

server {
    listen {{ .IP }}:443 ssl default_server;
    http2 on;
{{- if .HTTP3 }}
    listen {{ .IP }}:443 quic reuseport;
{{- end }}
    server_name _;
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;
    ssl_reject_handshake on;
}
{{- end }}
