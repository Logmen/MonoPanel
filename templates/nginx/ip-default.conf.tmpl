# Generated by MonoPanel — default server for {{ .IP }}: ACME challenges, HTTP/3 reuseport, unknown hosts.
# Port 443 refuses the handshake of a name no site has, and of a client without
# SNI: without this block nginx would answer them with the first site of the
# address in file order, and show its certificate. A site chosen for the
# clients without SNI (mp site set --default-tls) answers those instead.
server {
    listen {{ .IP }}:80 default_server;
    server_name _;
    include monopanel/snippets/acme.conf;
    location / {
{{- if .PanelHost }}
        # The panel's own name without the port leads to the panel; a site
        # with that name would match before this block and win.
        if ($host = "{{ .PanelHost }}") { return 301 https://$host:{{ .PanelPort }}$request_uri; }
{{- end }}
        return 444;
    }
}
{{- if .TLS }}

server {
    listen {{ .IP }}:443 ssl default_server;
    http2 on;
{{- if .HTTP3 }}
    listen {{ .IP }}:443 quic reuseport;
{{- end }}
    server_name _;
{{- if .CertPath }}
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
{{- end }}
    include monopanel/snippets/ssl.conf;
{{- if .NoSNISite }}
    # A client without SNI — a reverse proxy that connects by IP — gets the
    # certificate of {{ .NoSNISite }} (mp site set --default-tls), and its Host
    # picks the site; one that names the address itself is sent to
    # {{ .NoSNISite }}, another name no site has is refused below.
    location / {
        return 301 https://{{ .NoSNISite }}$request_uri;
    }
}

# A name no site has, when it comes as SNI, is still refused: any name with a
# letter, which an address never has (a Host that is the address itself, from
# a client without SNI, lands in the block above).
server {
    listen {{ .IP }}:443 ssl;
    http2 on;
    server_name "~[a-z]";
    include monopanel/snippets/ssl.conf;
    ssl_reject_handshake on;
    return 444;
}
{{- else }}
    ssl_reject_handshake on;
}
{{- end }}
{{- end }}
