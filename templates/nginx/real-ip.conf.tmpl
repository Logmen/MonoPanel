# Generated by MonoPanel — proxies trusted for the real client address. Do not edit; use `mp stack real-ip`.
{{- if .Cloudflare }}
# Cloudflare (https://www.cloudflare.com/ips/)
{{- range .CloudflareRanges }}
set_real_ip_from {{ . }};
{{- end }}
{{- end }}
{{- if .From }}
# Custom trusted proxies
{{- range .From }}
set_real_ip_from {{ . }};
{{- end }}
{{- end }}
{{- if .From }}
real_ip_header    X-Forwarded-For;
real_ip_recursive on;
{{- else if .Cloudflare }}
real_ip_header    CF-Connecting-IP;
{{- end }}
