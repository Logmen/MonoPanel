# Generated by MonoPanel for {{ .Domain }} — site is suspended.
server {
    listen {{ .IP }}:80;
{{- if .TLS }}
    listen {{ .IP }}:443 ssl;
    http2 on;
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;
{{- end }}
    server_name {{ .ServerNames }};
    include monopanel/snippets/acme.conf;
    location / {
        default_type text/html;
        return 503 '<!doctype html><html lang="ru"><meta charset="utf-8"><title>{{ .Domain }}</title><body style="font-family:system-ui;margin:10% auto;max-width:36em;text-align:center"><h1>Сайт временно недоступен</h1><p>{{ .Domain }} приостановлен администратором хостинга.</p></body></html>';
    }
}
