# Generated by MonoPanel for {{ .Domain }} — site is suspended.
server {
    listen {{ .IP }}:80;
{{- if .TLS }}
    listen {{ .IP }}:443 ssl;
    http2 on;
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;
{{- end }}
    server_name {{ .ServerNames }};
    include monopanel/snippets/acme.conf;
    location / {
        default_type text/html;
{{- /* English by default, Russian for a browser set to a CIS language (the rule of web/src/lib/i18n/detect.ts); no "$" in the script, nginx would take it for a variable */}}
        return 503 '<!doctype html><html lang="en"><meta charset="utf-8"><title>{{ .Domain }}</title><body style="font-family:system-ui;margin:10% auto;max-width:36em;text-align:center"><h1 id="h">The site is temporarily unavailable</h1><p id="p">{{ .Domain }} has been suspended by the hosting administrator.</p><script>try{var n=((navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||""])[0]||"").toLowerCase().split(/[-_]/);if("|ru|uk|be|kk|ky|uz|tg|tk|hy|az|ka|os|tt|ba|".indexOf("|"+n[0]+"|")>=0||(n[0]==="ro"&&n[1]==="md")){document.documentElement.lang="ru";document.getElementById("h").textContent="Сайт временно недоступен";document.getElementById("p").textContent="{{ .Domain }} приостановлен администратором хостинга."}}catch(e){}</script></body></html>';
    }
}
