# Generated by MonoPanel for {{ .Domain }} — do not edit. Custom directives: {{ .IncludeDir }}/*.conf
server {
    listen {{ .IP }}:80;
    server_name {{ .ServerNames }};
    include monopanel/snippets/acme.conf;
{{- if and .TLS .RedirectHTTPS }}
    location / { return 301 https://$host$request_uri; }
{{- else }}
{{ template "body" .Plain }}
{{- end }}
}
{{- if .TLS }}

server {
    listen {{ .IP }}:443 ssl;
    http2 {{ if .HTTP2 }}on{{ else }}off{{ end }};
{{- if .HTTP3 }}
    listen {{ .IP }}:443 quic;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
{{- end }}
    server_name {{ .ServerNames }};
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;
    include monopanel/snippets/acme.conf;
{{ template "body" . }}
}
{{- end }}

{{- define "body" }}
{{- if eq .RedirectWWW "to_root" }}
    if ($host = www.{{ .Domain }}) { return 301 $scheme://{{ .Domain }}$request_uri; }
{{- else if eq .RedirectWWW "to_www" }}
    if ($host = {{ .Domain }}) { return 301 $scheme://www.{{ .Domain }}$request_uri; }
{{- end }}
    root  {{ .Docroot }};
    index index.php index.html index.htm;
    access_log {{ .LogDir }}/{{ .Domain }}.access.log main;
    error_log  {{ .LogDir }}/{{ .Domain }}.error.log;
    client_max_body_size {{ .ClientMaxBodySize }};
    disable_symlinks if_not_owner from=$document_root;
{{- if .HSTS }}
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- end }}
{{- if .AllowFrom }}

    # Access restricted to these addresses (ACME challenges stay open)
{{- range .AllowFrom }}
    allow {{ . }};
{{- end }}
    deny  all;
{{- end }}

    include monopanel/snippets/deny-dotfiles.conf;
    include {{ .IncludeDir }}/*.conf;
{{- if eq .Mode "apache" }}
{{- if .StaticByNginx }}

    location ~* \.(?:css|js|mjs|map|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot|otf|mp4|webm|mp3|pdf|zip|gz|txt|xml)$ {
        try_files $uri @apache;
        include monopanel/snippets/static-cache.conf;
{{- template "tlsheaders" . }}
    }
{{- end }}

    location / {
        include monopanel/snippets/proxy-apache.conf;
        proxy_pass http://{{ .ApacheBackend }};
    }
    location @apache {
        include monopanel/snippets/proxy-apache.conf;
        proxy_pass http://{{ .ApacheBackend }};
    }
{{- else if eq .Mode "proxy" }}

    location / {
        include monopanel/snippets/proxy-app.conf;
        proxy_pass {{ .Backend }};
    }
{{- else if eq .Preset "wordpress" }}
{{- template "preset-wordpress" . }}
{{- else if eq .Preset "joomla" }}
{{- template "preset-joomla" . }}
{{- else if eq .Preset "bitrix" }}
{{- template "preset-bitrix" . }}
{{- else if eq .Preset "opencart" }}
{{- template "preset-opencart" . }}
{{- else }}

    location ~* \.(?:css|js|mjs|map|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot|otf|mp4|webm|mp3|pdf|zip|gz)$ {
        try_files $uri =404;
        include monopanel/snippets/static-cache.conf;
{{- template "tlsheaders" . }}
    }
    location / { try_files $uri $uri/ /index.php?$args; }
    location ~ \.php$ {
        try_files $uri =404;
        include monopanel/snippets/fastcgi.conf;
        fastcgi_pass unix:{{ .FPMSocket }};
    }
{{- end }}
{{- end }}

{{- /* add_header in a location drops the server-level headers; repeat the TLS ones there */}}
{{- define "tlsheaders" }}
{{- if .HSTS }}
        add_header Strict-Transport-Security "max-age=31536000" always;
{{- end }}
{{- if .HTTP3 }}
        add_header Alt-Svc 'h3=":443"; ma=86400' always;
{{- end }}
{{- end }}
