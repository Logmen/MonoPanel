# Generated by MonoPanel — do not edit. Custom http-level directives belong in /etc/nginx/conf.d/*.conf
user  {{ .User }};
worker_processes  auto;
worker_rlimit_nofile 65535;
pid        /run/nginx.pid;
error_log  /var/log/nginx/error.log warn;

events {
    worker_connections  4096;
    multi_accept        on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    '$request_time $upstream_response_time $host $server_protocol';
    access_log  /var/log/nginx/access.log main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 4096;
    server_tokens       off;
    server_names_hash_bucket_size 128;
    server_names_hash_max_size    4096;
    client_max_body_size 64m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml font/woff2;

    include /etc/nginx/monopanel/http.d/*.conf;
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/monopanel/sites/*.conf;
}
