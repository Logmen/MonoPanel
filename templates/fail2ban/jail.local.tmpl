# Generated by MonoPanel — jails for SSH, nginx and the panel itself.
# Do not edit: the panel rewrites this file when sites and trusted addresses
# change. Your own settings go to /etc/fail2ban/jail.d/zz-local.local —
# fail2ban reads it after this file, and the panel never touches it.
[DEFAULT]
banaction = nftables-multiport
banaction_allports = nftables-allports
bantime  = {{ .BanTime }}
findtime = {{ .FindTime }}
maxretry = {{ .MaxRetry }}
backend  = systemd
ignoreip = 127.0.0.1/8 ::1{{ range .IgnoreIPs }} {{ . }}{{ end }}

[sshd]
enabled = true
mode = aggressive

[monopanel]
enabled = true
port = {{ .PanelPort }}
filter = monopanel
journalmatch = _SYSTEMD_UNIT=monopanel-api.service
maxretry = 5

# The sites write their own logs, so each of them is listed: the shared nginx
# log sees only requests that matched no site. The list is explicit rather than
# a mask — *.error.log would also catch the sites' PHP error logs.
[nginx-http-auth]
enabled = {{ .Nginx }}
backend = auto
logpath = /var/log/nginx/error.log
{{- range .ErrorLogs }}
          {{ . }}
{{- end }}

[nginx-botsearch]
enabled = {{ .Nginx }}
backend = auto
logpath = /var/log/nginx/access.log
{{- range .AccessLogs }}
          {{ . }}
{{- end }}
