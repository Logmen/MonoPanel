# Generated by MonoPanel — правки будут перезаписаны (mp mail apply).
# Конфигурация полная: conf.d дистрибутива намеренно не подключается, чтобы
# состояние сервера определялось только панелью.
protocols = imap{{ if .POP3 }} pop3{{ end }} lmtp sieve
listen = *, ::
log_path = syslog
auth_mechanisms = plain login
disable_plaintext_auth = yes
mail_plugins = quota

mail_location = maildir:{{ .MailBase }}/%d/%n
mail_uid = {{ .VmailUID }}
mail_gid = {{ .VmailGID }}
first_valid_uid = {{ .VmailUID }}
last_valid_uid = {{ .VmailUID }}
mail_privileged_group = {{ .VmailUser }}
maildir_stat_dirs = yes

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
}

passdb {
  driver = passwd-file
  args = scheme=BLF-CRYPT username_format=%u {{ .UsersFile }}
}

userdb {
  driver = passwd-file
  args = username_format=%u {{ .UsersFile }}
  default_fields = uid={{ .VmailUID }} gid={{ .VmailGID }} home={{ .MailBase }}/%d/%n
}

{{- if .TLS }}

ssl = required
ssl_cert = <{{ .CertPath }}
ssl_key = <{{ .KeyPath }}
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes
{{- else }}

# Сертификата нет: почтовые клиенты смогут подключаться только без шифрования.
ssl = no
{{- end }}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
    user = {{ .VmailUser }}
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

{{- if .POP3 }}

service pop3-login {
  inet_listener pop3 {
    port = 110
  }
  inet_listener pop3s {
    port = 995
    ssl = yes
  }
}
{{- end }}

service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
}

protocol lmtp {
  mail_plugins = $mail_plugins sieve
  postmaster_address = {{ .Postmaster }}
  hostname = {{ .Hostname }}
}

protocol imap {
  mail_plugins = $mail_plugins imap_quota
  mail_max_userip_connections = 20
}

{{- if .POP3 }}

protocol pop3 {
  pop3_uidl_format = %08Xu%08Xv
  mail_max_userip_connections = 10
}
{{- end }}

plugin {
  quota = maildir:User quota
  quota_grace = 10%%
  quota_status_success = DUNNO
  quota_status_nouser = DUNNO
  quota_status_overquota = "552 5.2.2 Mailbox is full"
  sieve = file:{{ .MailBase }}/%d/%n/sieve;active={{ .MailBase }}/%d/%n/.dovecot.sieve
}
