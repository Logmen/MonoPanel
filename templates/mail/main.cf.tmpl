# Generated by MonoPanel — правки будут перезаписаны (mp mail apply).
# Домены, ящики и алиасы лежат в картах ниже; их пишет панель.
compatibility_level = 3.6
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
maillog_file_prefixes = /var/log

myhostname = {{ .Hostname }}
myorigin = $myhostname
mydestination = localhost.localdomain, localhost
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
inet_interfaces = all
inet_protocols = all
relayhost =
recipient_delimiter = +
message_size_limit = {{ .MessageSizeBytes }}
mailbox_size_limit = 0
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# Виртуальная почта: доставку делает dovecot по LMTP, он же считает квоты.
virtual_mailbox_domains = hash:{{ .MapsDir }}/domains
virtual_mailbox_maps = hash:{{ .MapsDir }}/mailboxes
virtual_alias_maps = hash:{{ .MapsDir }}/aliases
virtual_mailbox_base = {{ .MailBase }}
virtual_transport = lmtp:unix:private/dovecot-lmtp
virtual_uid_maps = static:{{ .VmailUID }}
virtual_gid_maps = static:{{ .VmailGID }}

# SASL отдаёт dovecot; на 25 порту авторизация выключена, она нужна на 587/465.
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
smtpd_sender_login_maps = hash:{{ .MapsDir }}/senders

{{- if .TLS }}
smtpd_tls_cert_file = {{ .CertPath }}
smtpd_tls_key_file = {{ .KeyPath }}
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_security_level = may
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_protocols = >=TLSv1.2
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_CApath = /etc/ssl/certs
tls_preempt_cipherlist = no
{{- else }}
# Сертификата пока нет: STARTTLS не предлагается, submission не работает.
smtpd_tls_security_level = none
{{- end }}

smtpd_helo_required = yes
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated reject_unauth_destination
# Проверки отправителя и HELO живут в одном списке с получателем, потому что
# только здесь известно, кому письмо: домен-приёмник (карта lenient) обрывает
# список на OK и получает даже то, что обычный домен отверг бы.
smtpd_recipient_restrictions =
    permit_mynetworks
    permit_sasl_authenticated
    reject_unauth_destination
    reject_unknown_recipient_domain
    reject_unlisted_recipient
    check_recipient_access hash:{{ .MapsDir }}/lenient
    reject_invalid_helo_hostname
    reject_non_fqdn_helo_hostname
    reject_non_fqdn_sender
    reject_unknown_sender_domain
{{- range .RBL }}
    reject_rbl_client {{ . }}
{{- end }}
smtpd_data_restrictions = reject_unauth_pipelining
smtpd_client_connection_count_limit = 20
smtpd_error_sleep_time = 3s
smtpd_soft_error_limit = 10
smtpd_hard_error_limit = 20
anvil_rate_time_unit = 60s

{{- if .Milter }}

# Подпись DKIM и проверка входящих.
milter_default_action = accept
milter_protocol = 6
smtpd_milters = {{ .Milter }}
non_smtpd_milters = {{ .Milter }}
{{- end }}
