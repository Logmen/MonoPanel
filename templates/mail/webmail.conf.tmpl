# Generated by MonoPanel — webmail on its own port. Do not edit: changes will be overwritten.
# The name and certificate are the mail server's, so no separate DNS record is
# needed: https://{{ .ServerName }}:{{ .Port }}/
server {
    listen {{ .IP }}:{{ .Port }} ssl;
{{- if ne .IP "127.0.0.1" }}
    listen 127.0.0.1:{{ .Port }} ssl;
{{- end }}
    http2 on;
    server_name {{ .ServerName }};
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;

    root  {{ .Docroot }};
    index index.php;
    access_log {{ .LogDir }}/webmail.access.log main;
    error_log  {{ .LogDir }}/webmail.error.log;
    client_max_body_size {{ .ClientMaxBodySize }};
    disable_symlinks if_not_owner from=$document_root;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include monopanel/snippets/deny-dotfiles.conf;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:{{ .Socket }};
        include monopanel/snippets/fastcgi.conf;
    }
}
