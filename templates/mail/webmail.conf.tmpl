# Generated by MonoPanel — webmail on its own port. Do not edit: changes will be overwritten.
# The name and certificate are the mail server's, so no separate DNS record is
# needed: https://{{ .ServerName }}:{{ .Port }}/

# Browsers send a host's cookies to every port of it: when the mail name is
# the panel's, the panel's session cookie (mp_session) would reach
# Roundcube's PHP, which runs in a site account's pool. PHP gets the Cookie
# header without it. Two of them (one a decoy the page set with a longer
# path, sent first) leave PHP no cookie at all.
map $http_cookie $monopanel_webmail_cookie {
    default $http_cookie;
    "~(?:^|;\s*)mp_session=.*;\s*mp_session=" "";
    "~^(?<monopanel_wm_ck_a>.*?)(?:^|;\s*)mp_session=[^;]*(?<monopanel_wm_ck_b>.*)$" "$monopanel_wm_ck_a$monopanel_wm_ck_b";
}

server {
    listen {{ .IP }}:{{ .Port }} ssl;
{{- if ne .IP "127.0.0.1" }}
    listen 127.0.0.1:{{ .Port }} ssl;
{{- end }}
    http2 on;
    server_name {{ .ServerName }};
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;

    root  {{ .Docroot }};
    index index.php;
    access_log {{ .LogDir }}/webmail.access.log main;
    error_log  {{ .LogDir }}/webmail.error.log;
    client_max_body_size {{ .ClientMaxBodySize }};
    disable_symlinks if_not_owner from=$document_root;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include monopanel/snippets/deny-dotfiles.conf;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # Roundcube 1.7 serves its CSS and JS through /static.php/<path>: the
    # script takes the path after its name (PATH_INFO).
    location ~ ^/[^/]+\.php(?:/|$) {
        if (!-f $document_root$fastcgi_script_name) { return 404; }
        fastcgi_pass unix:{{ .Socket }};
        include monopanel/snippets/fastcgi.conf;
        fastcgi_param HTTP_COOKIE $monopanel_webmail_cookie if_not_empty;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:{{ .Socket }};
        include monopanel/snippets/fastcgi.conf;
        fastcgi_param HTTP_COOKIE $monopanel_webmail_cookie if_not_empty;
    }
}
