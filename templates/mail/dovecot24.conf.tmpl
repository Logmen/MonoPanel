# Generated by MonoPanel — do not edit: changes will be overwritten (mp mail apply).
# dovecot 2.4 syntax (Debian 13, Ubuntu 26.04). The configuration is complete:
# the distribution's conf.d is deliberately not included, so that the server's
# state is defined by the panel alone.
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

protocols = imap{{ if .POP3 }} pop3{{ end }} lmtp sieve
listen = *, ::
log_path = syslog
auth_mechanisms = plain login
auth_allow_cleartext = no
hostname = {{ .Hostname }}
postmaster_address = {{ .Postmaster }}

mail_driver = maildir
mail_path = {{ .MailBase }}/%{user | domain}/%{user | username}
mail_uid = {{ .VmailUID }}
mail_gid = {{ .VmailGID }}
first_valid_uid = {{ .VmailUID }}
last_valid_uid = {{ .VmailUID }}
mail_privileged_group = {{ .VmailUser }}
maildir_stat_dirs = yes

mail_plugins {
  quota = yes
}

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
}

# Passwords carry their scheme ({BLF-CRYPT}…); the quota comes from the
# users file as userdb_quota_storage_size.
passdb passwd-file {
  passwd_file_path = {{ .UsersFile }}
}

userdb passwd-file {
  passwd_file_path = {{ .UsersFile }}
  fields {
    uid = {{ .VmailUID }}
    gid = {{ .VmailGID }}
    home = {{ .MailBase }}/%{user | domain}/%{user | username}
  }
}

quota "User quota" {
  driver = count
}

{{- if .TLS }}

ssl = required
ssl_server_cert_file = {{ .CertPath }}
ssl_server_key_file = {{ .KeyPath }}
ssl_min_protocol = TLSv1.2
ssl_server_prefer_ciphers = server
{{- else }}

# No certificate: mail clients can only connect without encryption.
ssl = no
{{- end }}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
    user = {{ .VmailUser }}
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

{{- if .POP3 }}

service pop3-login {
  inet_listener pop3 {
    port = 110
  }
  inet_listener pop3s {
    port = 995
    ssl = yes
  }
}
{{- end }}

service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
}

protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}

protocol imap {
  mail_plugins {
    imap_quota = yes
  }
  mail_max_userip_connections = 20
}

{{- if .POP3 }}

protocol pop3 {
  pop3_uidl_format = %{uidvalidity | hex(8)}%{uid | hex(8)}
  mail_max_userip_connections = 10
}
{{- end }}

sieve_script personal {
  driver = file
  path = {{ .MailBase }}/%{user | domain}/%{user | username}/sieve
  active_path = {{ .MailBase }}/%{user | domain}/%{user | username}/.dovecot.sieve
}
