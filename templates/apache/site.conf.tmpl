# Generated by MonoPanel for {{ .Domain }} — do not edit. Custom directives: {{ .IncludeDir }}/*.conf
<VirtualHost {{ .ApacheBackend }}>
    ServerName {{ .Domain }}
{{- range .Aliases }}
    ServerAlias {{ . }}
{{- end }}
    DocumentRoot {{ .Docroot }}
    <Directory {{ .Docroot }}>
        AllowOverride All
        Options -Indexes +SymLinksIfOwnerMatch
        Require all granted
    </Directory>
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{ .FPMSocket }}|fcgi://localhost"
    </FilesMatch>
    ProxyTimeout {{ .ProxyTimeout }}
    ErrorLog  {{ .LogDir }}/{{ .Domain }}.apache.error.log
    CustomLog {{ .LogDir }}/{{ .Domain }}.apache.access.log combined
    IncludeOptional {{ .IncludeDir }}/*.conf
</VirtualHost>
