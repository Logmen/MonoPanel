# Generated by MonoPanel — Apache runs behind nginx on loopback only.
{{- if .Listen }}
Listen {{ .Listen }}
{{- end }}
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5

RemoteIPHeader X-Real-IP
RemoteIPInternalProxy 127.0.0.1

<Directory /var/www>
    Options -Indexes +SymLinksIfOwnerMatch
    AllowOverride All
    Require all granted
</Directory>

IncludeOptional {{ .SitesDir }}/*.conf
