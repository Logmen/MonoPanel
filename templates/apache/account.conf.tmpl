# Generated by MonoPanel — do not edit. The Apache of {{ .Login }}
# (monopanel-apache@{{ .Login }}.service) for the account's sites in Apache mode,
# behind nginx. The parent runs as root: it binds {{ .Listen }}, an address of
# this account alone on a port only root can take, and opens the logs. The
# children serve the requests as {{ .Login }} and read what the account reads,
# nothing more. Custom directives of a site:
# {{ .SitesDir }}/<domain>.d/*.conf
ServerRoot /etc/apache2
PidFile {{ .RunDir }}/httpd.pid
DefaultRuntimeDir {{ .RunDir }}
Mutex file:{{ .RunDir }} default
User {{ .Login }}
Group {{ .Login }}
Listen {{ .Listen }}
ServerName localhost

# These modules and no others: nothing that runs programs (CGI, server-side
# includes, Lua, ext_filter), no status or info page.
LoadModule mpm_event_module /usr/lib/apache2/modules/mod_mpm_event.so
LoadModule authz_core_module /usr/lib/apache2/modules/mod_authz_core.so
LoadModule authz_host_module /usr/lib/apache2/modules/mod_authz_host.so
LoadModule authz_user_module /usr/lib/apache2/modules/mod_authz_user.so
LoadModule authn_core_module /usr/lib/apache2/modules/mod_authn_core.so
LoadModule authn_file_module /usr/lib/apache2/modules/mod_authn_file.so
LoadModule auth_basic_module /usr/lib/apache2/modules/mod_auth_basic.so
LoadModule access_compat_module /usr/lib/apache2/modules/mod_access_compat.so
LoadModule alias_module /usr/lib/apache2/modules/mod_alias.so
LoadModule dir_module /usr/lib/apache2/modules/mod_dir.so
LoadModule mime_module /usr/lib/apache2/modules/mod_mime.so
LoadModule env_module /usr/lib/apache2/modules/mod_env.so
LoadModule headers_module /usr/lib/apache2/modules/mod_headers.so
LoadModule expires_module /usr/lib/apache2/modules/mod_expires.so
LoadModule rewrite_module /usr/lib/apache2/modules/mod_rewrite.so
LoadModule setenvif_module /usr/lib/apache2/modules/mod_setenvif.so
LoadModule filter_module /usr/lib/apache2/modules/mod_filter.so
LoadModule deflate_module /usr/lib/apache2/modules/mod_deflate.so
LoadModule remoteip_module /usr/lib/apache2/modules/mod_remoteip.so
LoadModule proxy_module /usr/lib/apache2/modules/mod_proxy.so
LoadModule proxy_fcgi_module /usr/lib/apache2/modules/mod_proxy_fcgi.so
LoadModule negotiation_module /usr/lib/apache2/modules/mod_negotiation.so
LoadModule reqtimeout_module /usr/lib/apache2/modules/mod_reqtimeout.so
LoadModule autoindex_module /usr/lib/apache2/modules/mod_autoindex.so

# One child of 16 threads while idle, four at most (64 requests at once):
# nginx serves the static files and keeps the slow clients.
StartServers 1
ServerLimit 4
ThreadLimit 16
ThreadsPerChild 16
MinSpareThreads 8
MaxSpareThreads 32
MaxRequestWorkers 64
MaxConnectionsPerChild 10000

ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 300
KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5
HostnameLookups Off

ErrorLog {{ .ErrorLog }}
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\"" combined
LogFormat "%h %l %u %t \"%r\" %>s %O" common

# What Debian's mods-enabled/*.conf gave the shared Apache up to 0.8.19.
TypesConfig /etc/mime.types
AddType application/x-compress .Z
AddType application/x-gzip .gz .tgz
AddType application/x-bzip2 .bz2
AddHandler type-map var
DirectoryIndex index.html index.php index.xhtml index.htm
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/rss+xml application/xml image/svg+xml
RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
IndexIgnore .??* *~ *# RCS CVS *,v *,t

# nginx connects from 127.0.0.1 and sends the client's address.
RemoteIPHeader X-Real-IP
RemoteIPInternalProxy 127.0.0.1

AccessFileName .htaccess
<Directory />
    Options FollowSymLinks
    AllowOverride None
    Require all denied
</Directory>
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>
# What nginx answers 404 for (snippets/deny-dotfiles.conf): dotfiles and dot
# directories but .well-known and Bitrix's .default (.env, .git/config), the
# package managers' files. nginx never sends them here, but any local
# process can ask this address straight, another account's too.
<LocationMatch "/\.(?!well-known/|default/)">
    Require all denied
</LocationMatch>
<LocationMatch "(?i)(?:^|/)(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|\.user\.ini|\.htaccess|\.htpasswd)$">
    Require all denied
</LocationMatch>
# The account's tree: .htaccess may set any directive. What the children do
# there they do as {{ .Login }}, so neither ExecCGI and the exec of Includes
# (whose modules are not loaded) nor FollowSymLinks reach anything the
# account cannot reach itself; a folder another account writes to (a shared
# folder) is fenced off in its site's virtual host.
<Directory {{ .Home }}>
    Options -Indexes +SymLinksIfOwnerMatch
    AllowOverride All
    Require all granted
</Directory>

IncludeOptional {{ .SitesDir }}/*.conf
