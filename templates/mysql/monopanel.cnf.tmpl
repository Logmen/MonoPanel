# Generated by MonoPanel — sized for {{ .RAMMB }} MB RAM. Custom settings: add another file in this directory.
[mysqld]
bind-address = {{ .BindAddress }}
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
innodb_buffer_pool_size = {{ .BufferPoolMB }}M
innodb_redo_log_capacity = {{ .RedoLogMB }}M
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2
max_connections = {{ .MaxConnections }}
table_open_cache = 4000
tmp_table_size = 64M
max_heap_table_size = 64M
local_infile = OFF
performance_schema = ON
disable_log_bin
slow_query_log = ON
slow_query_log_file = {{ .SlowLog }}
long_query_time = 2
{{- if .NativePassword }}
# legacy PHP (< 7.4, mysqlnd without caching_sha2_password) is installed
mysql_native_password = ON
{{- end }}
