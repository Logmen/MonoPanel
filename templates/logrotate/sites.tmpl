# Generated by MonoPanel — do not edit: the panel rewrites this file whenever an
# account comes or goes.
#
# Site logs live in <log_dir>/sites/<login>/, a tree only root writes: nginx,
# Apache and the php-fpm master open them as root, and a log the account could
# swap for a symlink would turn their writes into root's anywhere. The account's
# directory is root:<login> 0751 — the account reads its logs through its group,
# the nginx workers pass through to reopen theirs — so logrotate works there as
# root, with nothing an account controls in its way. A log rotates weekly, or on
# the daily run once it has passed 100 MB; eight rotations stay, compressed from
# the second one on.
#
# The servers' logs (nginx, Apache, the php-fpm slow log) are root:<login> 0640:
# the panel makes them so before the servers open them, and create below does
# after a rotation. nginx gives a log to its worker user when it reopens it and
# keeps the group and the mode. The PHP error log is the account's, 0660: PHP
# itself, running as the account, opens it for every write. It has a stanza of
# its own, and since logrotate refuses a file two stanzas name, the four masks
# with *.error.log in the first one take every error log but the PHP ones.
#
# Afterwards nginx gets USR1 (its workers reopen the logs) and Apache a graceful
# restart, both through their pid files: asking systemd from here is what
# SELinux denies logrotate. PHP opens its error log and php-fpm its slow log
# anew for every write, so they need no signal.
{{- range .Accounts }}

{{ .LogDir }}/*.access.log {{ .LogDir }}/*[!p].error.log {{ .LogDir }}/*[!h]p.error.log {{ .LogDir }}/*[!p]hp.error.log {{ .LogDir }}/*[!.]php.error.log {{ .LogDir }}/*.php.slow.log {
	weekly
	maxsize 100M
	rotate 8
	nodateext
	missingok
	notifempty
	compress
	delaycompress
	create 0640 root {{ .Login }}
	sharedscripts
	postrotate
		[ ! -s {{ $.NginxPID }} ] || kill -USR1 "$(cat {{ $.NginxPID }})" 2>/dev/null || true
		[ ! -s {{ $.ApachePID }} ] || kill -USR1 "$(cat {{ $.ApachePID }})" 2>/dev/null || true
	endscript
}

{{ .LogDir }}/*.php.error.log {
	weekly
	maxsize 100M
	rotate 8
	nodateext
	missingok
	notifempty
	compress
	delaycompress
	create 0660 {{ .Login }} {{ .Login }}
}
{{- end }}
