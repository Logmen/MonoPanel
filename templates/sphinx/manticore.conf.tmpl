# Generated by MonoPanel — Manticore Search for 1C-Bitrix (the SphinxQL-compatible successor of Sphinx 2.2, which EL has no package for):
# one real-time index, SphinxQL on 127.0.0.1:9306. In Bitrix: Settings → Search → Sphinx, connection 127.0.0.1:9306, index {{ .Index }}.
index {{ .Index }}
{
    type = rt
    path = {{ .DataDir }}/{{ .Index }}
    morphology = stem_enru, soundex
    index_exact_words = 1
    min_word_len = 2
    min_prefix_len = 2
    # the underscore is a blend char, so it must not also be in charset_table (searchd refuses to serve the index otherwise)
    charset_table = 0..9, A..Z->a..z, a..z, U+410..U+42F->U+430..U+44F, U+430..U+44F, U+401->U+451, U+451
    blend_chars = _, -, @
    rt_field = title
    rt_field = body
    rt_attr_uint = module_id
    rt_attr_string = module
    rt_attr_uint = item_id
    rt_attr_string = item
    rt_attr_uint = param1_id
    rt_attr_string = param1
    rt_attr_uint = param2_id
    rt_attr_string = param2
    rt_attr_timestamp = date_change
    rt_attr_timestamp = date_to
    rt_attr_timestamp = date_from
    rt_attr_uint = custom_rank
    rt_attr_multi = tags
    rt_attr_multi = right
    rt_attr_multi = site
    rt_attr_multi = param
}

searchd
{
    listen = {{ .Listen }}:9312
    listen = {{ .Listen }}:9306:mysql41
    log = {{ .LogDir }}/searchd.log
    query_log = {{ .LogDir }}/query.log
    read_timeout = 5
    max_children = 30
    pid_file = {{ .PidFile }}
    seamless_rotate = 1
    preopen_indexes = 1
    unlink_old = 1
    binlog_path = {{ .DataDir }}
    rt_flush_period = 60
}
