# Generated by MonoPanel — Sphinx 3 for 1C-Bitrix (sphinxsearch.com build; EL has no distribution package).
# The index follows the "sphinx.conf - for 3.X" reference Bitrix ships (Settings → Search): Sphinx 3 silently ignores
# the 2.x attribute spellings, so the fields are declared the 3.x way. SphinxQL on 127.0.0.1:9306, index {{ .Index }}.
index {{ .Index }}
{
    type = rt
    path = {{ .DataDir }}/{{ .Index }}
    # lemmatize_ru_all needs the dictionaries from sphinxsearch.com; stemming works out of the box
    morphology = stem_enru, soundex
    # used by the bitrix:search.title component
    min_prefix_len = 2
    # all fields exactly as Bitrix expects them
    field = title
    field = body
    attr_uint = module_id
    attr_string = module
    attr_uint = item_id
    attr_string = item
    attr_uint = param1_id
    attr_string = param1
    attr_uint = param2_id
    attr_string = param2
    attr_uint = date_change
    attr_uint = date_to
    attr_uint = date_from
    attr_uint = custom_rank
    attr_uint_set = tags
    attr_uint_set = right
    attr_uint_set = site
    attr_uint_set = param
}

searchd
{
    listen = {{ .Listen }}:9312
    listen = {{ .Listen }}:9306:mysql41
    log = {{ .LogDir }}/searchd.log
    query_log = {{ .LogDir }}/query.log
    read_timeout = 5
    pid_file = {{ .PidFile }}
    binlog_path = {{ .DataDir }}
    rt_flush_period = 60
}
