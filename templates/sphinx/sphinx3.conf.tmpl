# Generated by MonoPanel — Sphinx 3 for 1C-Bitrix (sphinxsearch.com build; EL has no distribution package).
# The index follows the "sphinx.conf - for 3.X" reference Bitrix ships (Settings → Search): Sphinx 3 silently ignores
# the 2.x attribute spellings, so the fields are declared the 3.x way. SphinxQL on 127.0.0.1:9306, index {{ .Index }}.
index {{ .Index }}
{
    type = rt
    path = {{ .DataDir }}/{{ .Index }}
    # lemmatize_ru_all needs the dictionaries from sphinxsearch.com; stemming works out of the box
    morphology = stem_enru, soundex
    # used by the bitrix:search.title component
    min_prefix_len = 2
    # Without a table Sphinx 3 splits words on every letter beyond basic Cyrillic ("Қазақстан"
    # into "аза" + "стан"): Russian, then Kazakh (Ә Ғ Қ Ң Ө Ұ Ү Һ І), Ukrainian (Є Ї Ґ) and Belarusian (Ў).
    charset_table = 0..9, A..Z->a..z, _, a..z, U+410..U+42F->U+430..U+44F, U+430..U+44F, U+401->U+451, U+451, U+4D8->U+4D9, U+4D9, U+492->U+493, U+493, U+49A->U+49B, U+49B, U+4A2->U+4A3, U+4A3, U+4E8->U+4E9, U+4E9, U+4B0->U+4B1, U+4B1, U+4AE->U+4AF, U+4AF, U+4BA->U+4BB, U+4BB, U+406->U+456, U+456, U+404->U+454, U+454, U+407->U+457, U+457, U+490->U+491, U+491, U+40E->U+45E, U+45E
    # all fields exactly as Bitrix expects them
    field = title
    field = body
    attr_uint = module_id
    attr_string = module
    attr_uint = item_id
    attr_string = item
    # the search module of Bitrix 26 checks these too: without them it will not connect
    attr_uint = user_id
    attr_string = entity_type
    attr_uint = entity_type_id
    attr_string = entity
    attr_uint = entity_id
    attr_uint = param1_id
    attr_string = param1
    attr_uint = param2_id
    attr_string = param2
    attr_uint = date_change
    attr_uint = date_to
    attr_uint = date_from
    attr_uint = custom_rank
    attr_uint_set = tags
    attr_uint_set = right
    attr_uint_set = site
    attr_uint_set = param
}

searchd
{
    listen = {{ .Listen }}:9312
    listen = {{ .Listen }}:9306:mysql41
    log = {{ .LogDir }}/searchd.log
    query_log = {{ .LogDir }}/query.log
    read_timeout = 5
    pid_file = {{ .PidFile }}
    binlog_path = {{ .DataDir }}
    rt_flush_period = 60
}
