# Generated by MonoPanel — Sphinx 3 (sphinxsearch.com binaries) for 1C-Bitrix.
[Unit]
Description=Sphinx search server (MonoPanel, for 1C-Bitrix)
After=network.target

[Service]
Type=simple
User={{ .User }}
Group={{ .User }}
ExecStart={{ .InstallDir }}/bin/searchd --config {{ .ConfFile }} --nodetach
RuntimeDirectory=sphinx
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
