# Generated by MonoPanel — Sphinx 2.2 for 1C-Bitrix: one real-time index, SphinxQL on 127.0.0.1:9306.
# In Bitrix: Settings → Search → Sphinx, connection 127.0.0.1:9306, index {{ .Index }}.
index {{ .Index }}
{
    type = rt
    path = {{ .DataDir }}/{{ .Index }}
    docinfo = extern
    morphology = stem_enru, soundex
    dict = keywords
    index_exact_words = 1
    min_word_len = 2
    min_prefix_len = 2
    # the underscore is a blend char, so it must not also be in charset_table (searchd refuses to serve the index otherwise)
    # Russian, then Kazakh (Ә Ғ Қ Ң Ө Ұ Ү Һ І), Ukrainian (Є Ї Ґ) and Belarusian (Ў): a letter missing here splits words
    charset_table = 0..9, A..Z->a..z, a..z, U+410..U+42F->U+430..U+44F, U+430..U+44F, U+401->U+451, U+451, U+4D8->U+4D9, U+4D9, U+492->U+493, U+493, U+49A->U+49B, U+49B, U+4A2->U+4A3, U+4A3, U+4E8->U+4E9, U+4E9, U+4B0->U+4B1, U+4B1, U+4AE->U+4AF, U+4AF, U+4BA->U+4BB, U+4BB, U+406->U+456, U+456, U+404->U+454, U+454, U+407->U+457, U+457, U+490->U+491, U+491, U+40E->U+45E, U+45E
    blend_chars = _, -, @
    rt_field = title
    rt_field = body
    rt_attr_uint = module_id
    rt_attr_string = module
    rt_attr_uint = item_id
    rt_attr_string = item
    # the search module of Bitrix 26 checks these too: without them it will not connect
    rt_attr_uint = user_id
    rt_attr_string = entity_type
    rt_attr_uint = entity_type_id
    rt_attr_string = entity
    rt_attr_uint = entity_id
    rt_attr_uint = param1_id
    rt_attr_string = param1
    rt_attr_uint = param2_id
    rt_attr_string = param2
    rt_attr_timestamp = date_change
    rt_attr_timestamp = date_to
    rt_attr_timestamp = date_from
    rt_attr_uint = custom_rank
    rt_attr_multi = tags
    rt_attr_multi = right
    rt_attr_multi = site
    rt_attr_multi = param
}

searchd
{
    listen = {{ .Listen }}:9312
    listen = {{ .Listen }}:9306:mysql41
    log = {{ .LogDir }}/searchd.log
    query_log = {{ .LogDir }}/query.log
    read_timeout = 5
    max_children = 30
    pid_file = {{ .PidFile }}
    seamless_rotate = 1
    preopen_indexes = 1
    unlink_old = 1
    workers = threads
    binlog_path = {{ .DataDir }}
    rt_flush_period = 60
}
