#!/usr/sbin/nft -f
# Generated by MonoPanel — applied atomically; custom rules belong in the panel (mp firewall).
table inet monopanel {}
flush table inet monopanel
table inet monopanel {
    set banned4 { type ipv4_addr; flags interval; }
    set banned6 { type ipv6_addr; flags interval; }
    chain input {
        type filter hook input priority 0; policy {{ .Policy }};
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        ip saddr @banned4 drop
        ip6 saddr @banned6 drop
{{- range .Deny }}
        {{ . }}
{{- end }}
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
{{- range .Allow }}
        {{ . }}
{{- end }}
    }
    chain forward {
        type filter hook forward priority 0; policy accept;
    }
}
