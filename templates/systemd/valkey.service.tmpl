# Generated by MonoPanel for {{ .Login }} ({{ .Purpose }}) — do not edit; use `mp valkey`.
[Unit]
Description=MonoPanel {{ .Engine }} {{ .Purpose }} of {{ .Login }}
After=network.target

[Service]
# Started means ready: the snapshot is loaded and the socket accepts, so a
# restart does not hand PHP a missing socket and lose its sessions.
Type=notify
User={{ .Login }}
Group={{ .Login }}
# Only the account reaches the server: a unix socket with mode 600 in a
# directory of its own, no TCP port. The whole configuration is here, on the
# command line: the account cannot read the panel's /etc/monopanel.
ExecStart={{ .Binary }} --supervised systemd --daemonize no --port 0 \
	--unixsocket {{ .Socket }} --unixsocketperm 600 \
	--dir {{ .DataDir }} --maxmemory {{ .MemoryMB }}mb \
{{- if .Sessions }}
	--maxmemory-policy volatile-lru --save 60 1
{{- else }}
	--maxmemory-policy allkeys-lru --save ""
{{- end }}
RuntimeDirectory=monopanel-valkey/{{ .Name }}
RuntimeDirectoryMode=0700
StateDirectory=monopanel-valkey/{{ .Name }}
StateDirectoryMode=0700
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
MemoryMax={{ .MemoryMax }}M
# Mount sandboxing only. ProtectKernelTunables=, ProtectKernelModules= and
# RestrictAddressFamilies= imply NoNewPrivileges= for a non-root User=, and
# under it EL9's policy keeps the server in init_t instead of redis_t — where
# it may not write its own snapshots.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
