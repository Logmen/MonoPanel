# Generated by MonoPanel for {{ .Login }}/{{ .Name }} — do not edit; use `mp app`.
[Unit]
Description=MonoPanel app {{ .Login }}/{{ .Name }}{{ if .Description }} — {{ .Description }}{{ end }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ .Login }}
Group={{ .Login }}
WorkingDirectory={{ .WorkDir }}
ExecStart={{ .Command }}
{{- if .EnvFile }}
EnvironmentFile={{ .EnvFile }}
{{- end }}
{{- range .Env }}
Environment="{{ . }}"
{{- end }}
Restart={{ .Restart }}
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0027
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
