# Generated by MonoPanel for {{ .Login }}/{{ .Name }} — do not edit; use `mp app`.
[Unit]
Description=MonoPanel app {{ .Login }}/{{ .Name }}{{ if .Description }} — {{ .Description }}{{ end }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ .Login }}
Group={{ .Login }}
WorkingDirectory={{ .WorkDir }}
{{- if .EnvFile }}
# The account's own env file is read as the account (mp app-exec), not by
# systemd as root: a symlink there must not reach other files.
ExecStart={{ .Binary }} app-exec --env-file {{ .EnvFile }} -- {{ .Command }}
{{- else }}
ExecStart={{ .Command }}
{{- end }}
{{- if .PanelEnvFile }}
EnvironmentFile={{ .PanelEnvFile }}
{{- end }}
Restart={{ .Restart }}
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0027
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
