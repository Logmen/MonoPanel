<?php
// Generated by MonoPanel — the panel's sign-in into phpMyAdmin. Do not edit:
// changes will be overwritten.
//
// The panel's button leaves a ticket in the ticket directory, named after
// the sha256 of a random token, and sends the browser here with the token.
// The ticket holds a temporary MySQL account granted on one database; it
// is taken (read and removed: one sign-in per ticket) and its account goes
// into phpMyAdmin's sign-on session. A ticket that is missing, taken or
// past its time leads to the login form. Signing out leaves a mark the
// panel's sweep drops the temporary account for.
declare(strict_types=1);

const MP_TICKETS = '{{ .TicketDir }}';
const MP_LOGOUTS = '{{ .LogoutDir }}';
const MP_SESSION = 'MonoPanelSignon';

function mp_go(string $to): void
{
    header('Cache-Control: no-store');
    header('Location: ' . $to, true, 303);
    exit;
}

session_set_cookie_params(['lifetime' => 0, 'path' => '/', 'domain' => '', 'secure' => true, 'httponly' => true, 'samesite' => 'Lax']);
session_name(MP_SESSION);
session_start();

if (isset($_GET['logout'])) {
    $user = $_SESSION['PMA_single_signon_user'] ?? '';
    if (is_string($user) && preg_match('/^mp\\.pma\\.[0-9a-f]{16}$/D', $user) === 1) {
        @file_put_contents(MP_LOGOUTS . '/' . $user, '');
    }
    $_SESSION = [];
    session_destroy();
    mp_go('index.php?server=1');
}

$token = $_GET['t'] ?? '';
if (!is_string($token) || preg_match('/^[A-Za-z0-9_-]{43}$/D', $token) !== 1) {
    mp_go('index.php?server=1');
}
$name = hash('sha256', $token);
$file = MP_TICKETS . '/' . $name;
$raw = @file_get_contents($file);
// Only the request that removes the ticket uses it.
if ($raw === false || !@unlink($file)) {
    mp_go('index.php?server=1');
}
$ticket = json_decode($raw, true);
if (!is_array($ticket) || !hash_equals((string) ($ticket['hash'] ?? ''), $name)
    || (int) ($ticket['expires'] ?? 0) < time()
    || !is_string($ticket['user'] ?? null) || !is_string($ticket['password'] ?? null) || !is_string($ticket['db'] ?? null)) {
    mp_go('index.php?server=1');
}

session_regenerate_id(true);
$_SESSION['PMA_single_signon_user'] = $ticket['user'];
$_SESSION['PMA_single_signon_password'] = $ticket['password'];
$_SESSION['PMA_single_signon_cfgupdate'] = ['only_db' => $ticket['db']];
session_write_close();
mp_go('index.php?route=/database/structure&server=2&db=' . rawurlencode($ticket['db']));
