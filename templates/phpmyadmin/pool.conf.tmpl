; Generated by MonoPanel — phpMyAdmin's pool. Do not edit: changes will be overwritten.
[{{ .Name }}]
user  = {{ .User }}
group = {{ .User }}
listen = {{ .Socket }}
listen.owner = {{ .User }}
listen.group = {{ .ListenGroup }}
listen.mode  = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 60s
pm.max_requests = 500
request_terminate_timeout = 330s
catch_workers_output = no
clear_env = yes
env[PATH]   = /usr/local/bin:/usr/bin:/bin
env[TMPDIR] = {{ .StateDir }}/tmp
php_admin_value[open_basedir]       = {{ .Tree }}/:{{ .StateDir }}/:{{ .RunDir }}/
php_admin_value[upload_tmp_dir]     = {{ .StateDir }}/tmp
php_admin_value[sys_temp_dir]       = {{ .StateDir }}/tmp
php_admin_value[session.save_path]  = {{ .StateDir }}/sessions
php_admin_value[session.gc_maxlifetime] = 28800
php_admin_value[session.gc_probability] = 1
php_admin_value[session.gc_divisor] = 100
php_admin_value[error_log]          = {{ .StateDir }}/php.error.log
php_admin_flag[log_errors]          = on
php_admin_flag[display_errors]      = off
php_admin_flag[allow_url_fopen]     = off
php_admin_value[disable_functions]  = {{ .DisableFunctions }}
php_admin_value[memory_limit]       = 512M
php_admin_value[max_execution_time] = 300
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size]      = 64M
