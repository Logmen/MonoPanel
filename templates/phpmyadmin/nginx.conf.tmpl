# Generated by MonoPanel — phpMyAdmin on its own port. Do not edit: changes will be overwritten.
# The name and certificate are the panel's: https://{{ .ServerName }}:{{ .Port }}/

# The panel's sign-in is logged without its query: the one-time token stays
# out of the log.
log_format monopanel_pma_signon '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                                '$status $body_bytes_sent "$http_referer" "$http_user_agent" $request_time';

# Browsers send a host's cookies to every port of it: the panel's session
# cookie (mp_session) would reach phpMyAdmin's PHP, which runs as another
# user. PHP gets the Cookie header without it. Two of them (one a decoy the
# page set with a longer path, sent first) leave PHP no cookie at all.
map $http_cookie $monopanel_pma_cookie {
    default $http_cookie;
    "~(?:^|;\s*)mp_session=.*;\s*mp_session=" "";
    "~^(?<monopanel_pma_ck_a>.*?)(?:^|;\s*)mp_session=[^;]*(?<monopanel_pma_ck_b>.*)$" "$monopanel_pma_ck_a$monopanel_pma_ck_b";
}

server {
    listen {{ .Port }} ssl;
    http2 on;
    server_name {{ .ServerName }};
    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
    include monopanel/snippets/ssl.conf;

    root  {{ .Docroot }};
    index index.php;
    access_log /var/log/nginx/monopanel-phpmyadmin.access.log main;
    error_log  /var/log/nginx/monopanel-phpmyadmin.error.log;
    client_max_body_size 64m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include monopanel/snippets/deny-dotfiles.conf;

    # The configuration, the setup script and the code below the web root
    # are not phpMyAdmin's pages.
    location = /config.inc.php { return 404; }
    location ~ ^/(setup|libraries|templates|vendor|sql|examples|po|locale|tmp|test)(/|$) { return 404; }

    location / {
        try_files $uri $uri/ =404;
    }

    location = /monopanel-signon.php {
        access_log /var/log/nginx/monopanel-phpmyadmin.access.log monopanel_pma_signon;
        fastcgi_pass unix:{{ .Socket }};
        include monopanel/snippets/fastcgi.conf;
        fastcgi_param HTTP_COOKIE $monopanel_pma_cookie if_not_empty;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:{{ .Socket }};
        include monopanel/snippets/fastcgi.conf;
        fastcgi_param HTTP_COOKIE $monopanel_pma_cookie if_not_empty;
    }
}
